# Auto detect text files and perform LF normalization
* text=auto

# Source code and config files using LF
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf

# Windows specific scripts using CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts using LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
